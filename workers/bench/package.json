{
  "name": "@soroush/bench-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "config:gen": "gen-wrangler WORKER_NAME BENCH_GH_APP_ID",
    "setup": "worker-setup-env",
    "predev": "pnpm config:gen",
    "dev": "wrangler dev --port 8788",
    "predeploy": "pnpm config:gen",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@soroush.tech/eslint-config": "workspace:*",
    "@soroush.tech/wrangler-tools": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  }
}

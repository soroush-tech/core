{
  "name": "${WORKER_NAME}",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-18",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "routes": [{ "pattern": "api.bench.soroush.tech", "custom_domain": true }],
  "vars": {
    "BENCH_GH_APP_ID": "${BENCH_GH_APP_ID}"
  }
}

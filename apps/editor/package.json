{
  "name": "@soroush/editor",
  "description": "Claude-integrated desktop markdown editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Custom -> SEE LICENSE file",
  "author": {
    "name": "Masoud Soroush",
    "email": "masoud@soroush.tech"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "test:coverage:e2e": "cross-env E2E_COVERAGE=true pnpm test:e2e",
    "coverage:check:e2e": "node ../web/scripts/coverage-check.ts --file=coverage/e2e/lcov.info"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@soroush.tech/design-system": "workspace:*",
    "@soroush.tech/markdown": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@soroush.tech/eslint-config": "workspace:*",
    "@soroush.tech/playwright-coverage": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "monocart-coverage-reports": "^2.12.12",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}

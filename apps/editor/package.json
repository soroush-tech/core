{
  "name": "@soroush/editor",
  "description": "Claude-integrated desktop markdown editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "license": "Custom -> SEE LICENSE file",
  "author": {
    "name": "Masoud Soroush",
    "email": "masoud@soroush.tech"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "test:coverage:e2e": "cross-env E2E_COVERAGE=true pnpm test:e2e",
    "coverage:check:e2e": "node ../web/scripts/coverage-check.ts --file=coverage/e2e/lcov.info",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@soroush.tech/design-system": "workspace:*",
    "@soroush.tech/eslint-config": "workspace:*",
    "@soroush.tech/markdown": "workspace:*",
    "@soroush.tech/playwright-coverage": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "monocart-coverage-reports": "^2.13.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
